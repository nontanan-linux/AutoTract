#!/bin/bash

# ROS2 setup (auto-detect humble or foxy)
if [ -f /opt/ros/humble/setup.bash ]; then
    source /opt/ros/humble/setup.bash
elif [ -f /opt/ros/foxy/setup.bash ]; then
    source /opt/ros/foxy/setup.bash
fi

# Workspace setup
WORKSPACE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export TRACTER_WS="$WORKSPACE_DIR"

if [ -f "$TRACTER_WS/install/setup.bash" ]; then
    source "$TRACTER_WS/install/setup.bash"
    echo "Sourced AutoTract workspace: $TRACTER_WS/install/setup.bash"
fi

echo "AutoTract environment setup complete."
