# ROS2 Environment Configuration
ROS_DISTRO=humble
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ROS_DOMAIN_ID=0
ROS_LOCALHOST_ONLY=1

# Workspace Configuration
WORKSPACE_DIR=/home/nontanan/Tracter_trailer
COLCON_WS=${WORKSPACE_DIR}/tracter_ws

# Gazebo/Simulation Configuration
GAZEBO_MODEL_PATH=${WORKSPACE_DIR}/tracter_ws/src/tracter_control/models:${GAZEBO_MODEL_PATH}

# Python Path for custom packages
PYTHONPATH=${WORKSPACE_DIR}/tracter_ws/src/tracter_control:${PYTHONPATH}

# Git Configuration (for vcs tools)
REPOS_FILE=${WORKSPACE_DIR}/tracter_ws/tracter.repos
