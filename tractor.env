#!/bin/bash

# ==========================================
# Environment Setup for Tracter Simulation
# ==========================================

# 0. System Check: Multicast (Critical for CycloneDDS)
# if ! route -n | grep -q "224.0.0.0"; then
#     echo "=========================================================="
#     echo " WARNING: Multicast route for 224.0.0.0 is MISSING!"
#     echo " Simulation may fail (Service Discovery issues)."
#     echo " Run this command to fix:"
#     echo " sudo route add -net 224.0.0.0 netmask 240.0.0.0 dev lo"
#     echo "=========================================================="
# fi

# 1. ROS 2 Setup
source /opt/ros/jazzy/setup.bash

# 2. CARLA Setup (0.9.16 verified)
export CARLA_ROOT=$HOME/AutoTract/carla

# Verify CARLA_ROOT exists
if [ ! -d "$CARLA_ROOT" ]; then
    echo "WARNING: CARLA_ROOT ($CARLA_ROOT) not found."
fi

# Add CARLA PythonAPI to use 'agents' module (not in pip package)
if [ -d "$CARLA_ROOT/PythonAPI/carla" ]; then
    export PYTHONPATH=$PYTHONPATH:$CARLA_ROOT/PythonAPI/carla
fi

# Note: Main 'carla' module is assumed installed via pip (wheel found in dist/)

# ROS2 Environment Configuration
export ROS_DISTRO=jazzy
export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
export ROS_DOMAIN_ID=0
export ROS_LOCALHOST_ONLY=0

# Workspace Configuration
export WORKSPACE_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
export CYCLONEDDS_URI=${WORKSPACE_DIR}/autoware/docker/files/cyclonedds.xml
export COLCON_WS=${WORKSPACE_DIR}/tracter_ws

if [ -f "${WORKSPACE_DIR}/install/setup.bash" ]; then
    source "${WORKSPACE_DIR}/install/setup.bash"
else
    echo "WARNING: ${WORKSPACE_DIR}/install/setup.bash not found. Please build the workspace."
fi
# Gazebo/Simulation Configuration
export GAZEBO_MODEL_PATH=${WORKSPACE_DIR}/tracter_ws/src/tracter_control/models:${GAZEBO_MODEL_PATH}

# Python Path for custom packages
export PYTHONPATH=${WORKSPACE_DIR}/tracter_ws/src/tracter_control:${PYTHONPATH}

# Git Configuration (for vcs tools)
export REPOS_FILE=${WORKSPACE_DIR}/AutoTract.repos
